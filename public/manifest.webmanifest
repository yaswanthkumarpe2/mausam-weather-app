{
  "name": "Mausam",
  "short_name": "Mausam",
  "description": "A personalized weather app with maps, farm and health hubs, trip planning and community reports.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a2540",
  "theme_color": "#0a2540",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Rain radar", "url": "./#/map", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Farm hub", "url": "./#/farm", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
